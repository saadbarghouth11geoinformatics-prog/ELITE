{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/New Videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(mp4|webm|mov|m4v)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/menu-pages", "destination": "/menu-pages.html" },
    { "source": "/menu-text", "destination": "/menu-text.html" },
    { "source": "/kitchen", "destination": "/kitchen.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/contact", "destination": "/contact.html" },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
